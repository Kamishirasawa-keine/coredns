.:53 {
    bind ::
    prometheus 127.0.0.1:9153
    errors
    bufsize 1232
    blocklist rule.txt {
        block_response NXDOMAIN
        allowlist /etc/coredns/adblock/allowlist.txt
    }
    cache {
        success 32768 86400 5
        denial 32768 3600 5
        serve_stale 86400s immediate 30s
    }
    splitroute {
        mode remote_first
        reload 10m
        fallback 500ms
        bootstrap-dns 2400:3200::1
        local quic://dns.alidns.com tls://dot.pub {
            concurrent all
            timeout 2s
            ignore-rcode SERVFAIL
        }
        remote https://dns.google/dns-query {
#            concurrent 2
            timeout 5s
            via socks5 127.0.0.1:10808
            ecs4 /24
            ecs6 /56
            pipeline
        }
    }
}
