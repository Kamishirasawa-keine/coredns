#!/bin/sh /etc/rc.common
START=60
USE_PROCD=1

start_service() {
	local enabled
	config_load coredns
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	/usr/bin/coredns -check-config /etc/coredns/Corefile || return 1
	procd_open_instance
	procd_set_param command /usr/bin/coredns -conf /etc/coredns/Corefile
	procd_set_param file /etc/coredns/Corefile
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger coredns
}
